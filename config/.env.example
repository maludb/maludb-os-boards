# Boards — config/.env (written by the kernel's installer at apply, the four ports and BOARDS_LIVE_KEY pinned first by
# deploy/ROOT_STEPS.sh; design §14). Never commit the real file. Group www-data reads it; nothing in it is ever logged, printed or
# returned.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Boards"
APP_KEY=boards
APP_URL=https://boards.example.com
# the record database (the installer creates it and the three roles)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_boards
DB_USER=boards_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=boards_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=boards_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (pinned before the first apply: deploy/ROOT_STEPS.sh step 1 — the installer assigns only APP_INTERNAL_PORT and the MCP
# endpoints' ports, never BOARDS_LIVE_PORT; design §0.3, research/dev-server-survey.md)
APP_INTERNAL_PORT=8198
MCP_RECORDS_PORT=8849
MCP_ACTIVITY_PORT=8850
BOARDS_LIVE_PORT=8851
# the live relay's ticket key (32 random bytes, hex; ROOT_STEPS.sh writes it once): PHP signs a 60-second ticket
# {member}.{room}.{level}.{exp}.{hmac} with it, the relay verifies it (design §8). Rotating it closes every live socket; the boards
# fall back to polling until their pages reload.
BOARDS_LIVE_KEY=
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes) — Boards keeps no memory database of its own
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# mail (optional; the installer fills them from ~/.malumail or the kernel's) — notifications only; Boards reads no mailbox
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# the attachment store: images, files, thumbnails (default storage/ under the application; www-data writes it)
BD_STORAGE_DIR=storage
# CORS origins for the token API, comma-separated (none by default)
API_CORS_ORIGINS=
