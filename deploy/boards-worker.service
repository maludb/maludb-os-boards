[Unit]
Description=Boards worker — one pass: interval versions, the outbox, agent dispatches, the search catch-up, thumbnails, the trash, op compaction and item purge, key-usage pruning
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory={{APP_DIR}}
ExecStart=/usr/bin/php {{APP_DIR}}/bin/worker.php
